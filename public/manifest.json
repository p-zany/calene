{
	"id": "/",
	"name": "Calene",
	"short_name": "Calene",
	"description": "Immersive 1-on-1 video chat and co-viewing web client for Galene",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"display_override": ["window-controls-overlay", "standalone"],
	"launch_handler": {
		"client_mode": ["focus-existing", "auto"]
	},
	"orientation": "any",
	"background_color": "#09090b",
	"theme_color": "#09090b",
	"icons": [
		{
			"src": "/icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icon-maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	]
}
